# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8093
BACKEND_API_PREFIX=/api/v1

# QA mode is implemented in the backend (newschoolapp/utils/qa_mode.py) and
# enabled by the .qa_mode_enabled flag file in the backend repo root. It returns
# generated passwords and invite/reset links under a `test_mode` key on the
# response body, and in the X-Test-Mode header. See tests/fixtures/credentials.py.
BACKEND_TEST_MODE=true
BACKEND_QA_FLAG_FILE=.qa_mode_enabled

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ─── SuperAdmin bootstrap ─────────────────────────────────────────────────────
# NOTE: the backend's /users/register REFUSES to create SuperAdmins
# ("Cannot self-register with super admin privileges"), so the suite seeds this
# user by exec'ing the app's own code inside the backend container. Idempotent —
# safe to re-run. The suite then logs in via the UI.
#
# NOTE 2: the backend rejects reserved TLDs (.test/.example/.invalid) with a 422
# from its email validator. Test emails MUST use a normal-looking domain.
SUPERADMIN_EMAIL=playwright-super@learningbrix-qa.com
SUPERADMIN_PASSWORD=ChangeMe!2026
SUPERADMIN_FIRST_NAME=Playwright
SUPERADMIN_OTHER_NAMES=Super

# Docker container running the backend — used only for the SuperAdmin seed.
# Leave empty if the backend runs on the host; the seed will then be skipped and
# an existing SuperAdmin login is required.
BACKEND_CONTAINER=schoolapp
# Domain used for every generated test email. Must not be a reserved TLD.
TEST_EMAIL_DOMAIN=learningbrix-qa.com

# ─── Browser ──────────────────────────────────────────────────────────────────
HEADLESS=false
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# ─── Behavior ─────────────────────────────────────────────────────────────────
# Always delete schools in teardown (true). If false, keeps schools on failure
# for live inspection.
DELETE_ON_FAILURE=true

# Path to the scenarios YAML
FEATURE_SCENARIOS_PATH=config/feature_scenarios.yaml

# ─── Demo video recording ─────────────────────────────────────────────────────
# Slow-mo is applied ONLY to video-recording demo runs, so footage is watchable
# without slowing the main assertion suite.
VIDEO_ENABLED=true
VIDEO_SLOW_MO_MS=400
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_MAX_SECONDS=150
VIDEO_RAW_DIR=artifacts/videos/raw
VIDEO_OUT_DIR=artifacts/videos/out

# ─── Local app repos (agents may fix these, but must never commit) ────────────
BACKEND_REPO_PATH=/absolute/path/to/newschoolapp
FRONTEND_REPO_PATH=/absolute/path/to/smsfrontend
BACKEND_START_CMD=uvicorn app:app --reload --port 8093
FRONTEND_START_CMD=npm run dev
