# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_BASE_URL=http://localhost:8000
BACKEND_API_PREFIX=/api/v1

# When true, the backend should include reset/invite links inline in API
# responses (under a `test_mode` key) instead of only sending them by email.
BACKEND_TEST_MODE=true

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_BASE_URL=http://localhost:3000

# ─── SuperAdmin bootstrap ─────────────────────────────────────────────────────
# The suite creates this user via the backend API at session start (idempotent —
# safe to re-run). Then it logs in via the UI.
SUPERADMIN_EMAIL=playwright-super@learningbrix.test
SUPERADMIN_PASSWORD=ChangeMe!2026
SUPERADMIN_FIRST_NAME=Playwright
SUPERADMIN_OTHER_NAMES=Super

# ─── Browser ──────────────────────────────────────────────────────────────────
HEADLESS=false
SLOW_MO_MS=0
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
VIEWPORT_WIDTH=1440
VIEWPORT_HEIGHT=900

# ─── Behavior ─────────────────────────────────────────────────────────────────
# Always delete schools in teardown (true). If false, keeps schools on failure
# for live inspection.
DELETE_ON_FAILURE=true

# Path to the scenarios YAML
FEATURE_SCENARIOS_PATH=config/feature_scenarios.yaml
